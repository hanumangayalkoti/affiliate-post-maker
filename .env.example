# ═══════════════════════════════════════════════════════════════
# Deal Post Maker — Railway Variables
# Railway → bot service → Variables → "Raw Editor" → ye poora paste karo
# Sirf jahan PASTE_HERE likha hai wahan apni value daalo
# ═══════════════════════════════════════════════════════════════

# ── ZAROORI ─────────────────────────────────────────────────────
BOT_TOKEN="PASTE_HERE"
ADMIN_ID="PASTE_HERE"
DATABASE_URL="${{Postgres.DATABASE_URL}}"
CREDENTIAL_ID="PASTE_HERE"
CREDENTIAL_SECRET="PASTE_HERE"
PARTNER_TAG="dealskoti-21"
CREDENTIAL_VERSION="3.2"
MARKETPLACE="www.amazon.in"

# ── FORCE JOIN (bot use karne se pehle update channel join) ─────
# Bot ko is channel mein ADMIN banana zaroori hai. Khaali chhodo to band.
FORCE_JOIN_CHANNEL="@dealskoti"
FORCE_JOIN_NAME="DealsKoti"
# Private channel ho to upar -100... ID daalo aur invite link yahan:
# FORCE_JOIN_LINK="https://t.me/+xxxx"

# ── PAYMENT (Razorpay) ──────────────────────────────────────────
RAZORPAY_KEY_ID="PASTE_HERE"
RAZORPAY_KEY_SECRET="PASTE_HERE"
RAZORPAY_WEBHOOK_SECRET="PASTE_HERE"
STARS_ENABLED="true"

# ── BOT INFO ────────────────────────────────────────────────────
BOT_NAME="Deal Post Maker"
SUPPORT_USERNAME="PASTE_HERE"

# ── PLANS (optional — ye default hain) ──────────────────────────
PLAN_DAYS="30"
TRIAL_DAYS="7"
PRICE_BASIC="50"
PRICE_PRO="100"
PRICE_PREMIUM="250"
STARS_BASIC="50"
STARS_PRO="100"
STARS_PREMIUM="250"
DAILY_BASIC="200"
DAILY_PRO="500"
DAILY_PREMIUM="1200"

# ── CACHE / TIME ────────────────────────────────────────────────
CACHE_FRESH_MINUTES="30"
CACHE_KEEP_DAYS="5"
TZ_NAME="Asia/Kolkata"
